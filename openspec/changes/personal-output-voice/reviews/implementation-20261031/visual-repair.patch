+      await choose(value.options[0]!.optionId);
+      expect(posts(h)).toHaveLength(1);
+
+      await act(async () => {
+        finishRead!(response(value));
+        await flush();
+      });
+      expect(statuses()).toEqual([]);
+      expect(nodes("Select")[0]!.props).toMatchObject({
+        value: "server-default",
+        disabled: true,
