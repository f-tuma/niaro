{
  "version": 1,
  "name": "Microsoft 365",
  "source": {
    "npm": "@softeria/ms-365-mcp-server",
    "version": "0.156.2",
    "bin": "ms-365-mcp-server"
  },
  "args": [
    "--http",
    "0.0.0.0:{port}",
    "--preset",
    "calendar,mail",
    "--allow-unauthenticated-discovery"
  ],
  "env": { "MS365_MCP_BODY_FORMAT": "html" },
  "secrets": [],
  "memoryMb": 512,
  "path": "/mcp",
  "onboarding": {
    "icon": "mail",
    "description": "Mail and calendar of each person's own Microsoft 365 account.",
    "signIn": {
      "provider": "microsoft",
      "requiredFor": "all",
      "scopes": ["Calendars.ReadWrite", "Mail.ReadWrite", "Mail.Send"]
    }
  }
}
