# Copy to .env (ignored by git) and fill in. Loaded by the reference server at
# start (`pnpm server`) and by `docker compose` next to compose.yml.

# Optional default profile for `pnpm server` and `pnpm server:check`.
# Explicit profile arguments still take precedence.
SERVER_PROFILE=

# Invitation email (SMTP). When SMTP_HOST is set, these values replace
# administration.identity.mail from the server profile.
# SMTP_SECURE: true = implicit TLS (port 465), starttls = STARTTLS upgrade
# (port 587, fails rather than sending unencrypted), false = plain, accepted
# only for a loopback host such as the local Mailpit.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in invitations: an address or a name with it, without quotes
# around the whole value, e.g. Niaro <assistant@example.com>
SMTP_FROM=

# --- Container deployment (compose.yml, compose.dokploy.yml) ----------------
# On Dokploy, set these in the service's Environment tab instead of a file.
# Keep them commented in a development .env: the reference server reads this
# file too, and NIARO_PUBLIC_URL would replace the profile's baseURL.
#
# The one public origin people open (required on Dokploy). HTTPS in
# production; http://localhost:8793 only for a trial on one machine.
# NIARO_PUBLIC_URL=https://assistant.example.com
#
# compose.yml: host path of the server profile. compose.dokploy.yml: an
# optional path in the container (a Dokploy file mount); without a profile
# the server builds the automatic profile from these variables.
# NIARO_CONFIG=./config/server.json
#
# Automatic profile only (no profile file): the server's name, default time
# zone (else TZ, else Europe/Prague), data directory and port. Name and time
# zone can be changed later in administration (Settings).
# NIARO_NAME=Niaro
# NIARO_TIME_ZONE=Europe/Prague
# NIARO_DATA=/data
# NIARO_PORT=8793
#
# Trust X-Forwarded-For from the proxy in front: auto (only with an HTTPS
# public URL), 1 always, 0 never.
# NIARO_TRUST_PROXY=auto
#
# Only these proxy addresses (IPs or CIDR ranges, comma-separated) may set
# X-Forwarded-For. On Dokploy every app shares dokploy-network; set this to
# Traefik's address there (see docs/guides/deployment.md). Unset: any private peer.
# NIARO_TRUSTED_PROXIES=
#
# Hosted MCP servers (Administration → Hosted): auto (Docker when it answers,
# else confined child processes), docker or process.
# NIARO_HOSTED_RUNTIME=auto
#
# Agent runs at once across everyone (1–64).
# NIARO_MAX_CONCURRENT_RUNS=8
#
# Data volume name; restore into a new volume and point this at it to switch.
# NIARO_DATA_VOLUME=niaro-data
#
# compose.dokploy.yml builds from GitHub: branch, tag or commit to build.
# NIARO_GIT_REF=main
#
# Image tag the build produces.
# NIARO_IMAGE=niaro:local
#
# Optional speaker diarization (docs/guides/deployment.md, "Optional speaker diarization"):
# start the compose profile, then turn it on in administration (Settings →
# Meetings). HF_TOKEN: a Hugging Face read token whose account accepted the
# terms of pyannote/speaker-diarization-community-1. DIARIZER_TOKEN: a shared
# secret the service requires; compose gives it to the server as
# NIARO_DIARIZATION_TOKEN (set that one directly for `pnpm server`).
# COMPOSE_PROFILES=diarization
# HF_TOKEN=
# DIARIZER_TOKEN=
# DIARIZER_THREADS=0
# DIARIZER_MEMORY=4g

# Optional private attachment storage foundation (no attachment UI yet).
# All absent disables storage; partial/invalid settings are reported distinctly.
# See docs/guides/object-storage.md. No credentials belong in client settings.
# NIARO_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# NIARO_S3_REGION=fsn1
# NIARO_S3_BUCKET=your-private-dedicated-bucket
# NIARO_S3_PREFIX=attachments
# NIARO_S3_CREDENTIAL_MODE=static
# NIARO_S3_ACCESS_KEY_ID_FILE=/run/secrets/s3-access-key
# NIARO_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3-secret-key
# NIARO_S3_SESSION_TOKEN_FILE=/run/secrets/s3-session-token
# Direct alternatives: NIARO_S3_ACCESS_KEY_ID, NIARO_S3_SECRET_ACCESS_KEY,
# NIARO_S3_SESSION_TOKEN. Do not supply both direct and file variants.
# NIARO_S3_FORCE_PATH_STYLE=false
# NIARO_S3_ALLOW_HTTP=false
# CREDENTIAL_MODE=default explicitly selects the SDK chain; no NIARO static keys.
# Local RustFS profile: endpoint http://rustfs:9000, region us-east-1,
# FORCE_PATH_STYLE=true and ALLOW_HTTP=true, with separate non-default root keys.
# NIARO_RUSTFS_ROOT_ACCESS_KEY=
# NIARO_RUSTFS_ROOT_SECRET_KEY=
# NIARO_RUSTFS_PORT=19010  # loopback API only; console disabled
