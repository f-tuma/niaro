# Copy to .env (ignored by git) and fill in. Loaded by the reference server at
# start (`pnpm server`) and by `docker compose` next to compose.yml.

# Optional default profile for `pnpm server` and `pnpm server:check`.
# Explicit profile arguments still take precedence.
SERVER_PROFILE=

# Invitation email (SMTP). When SMTP_HOST is set, these values replace
# administration.identity.mail from the server profile.
# SMTP_SECURE: true = implicit TLS (port 465), starttls = STARTTLS upgrade
# (port 587, fails rather than sending unencrypted), false = plain, accepted
# only for a loopback host such as the local Mailpit.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown in invitations, e.g. Niaro <assistant@example.com>
SMTP_FROM=

# --- Container deployment (compose.yml, compose.dokploy.yml) ----------------
# On Dokploy, set these in the service's Environment tab instead of a file.
# Keep them commented in a development .env: the reference server reads this
# file too, and NIARO_PUBLIC_URL would replace the profile's baseURL.
#
# The one public origin people open (required on Dokploy). HTTPS in
# production; http://localhost:8793 only for a trial on one machine.
# NIARO_PUBLIC_URL=https://assistant.example.com
#
# compose.yml only: host path of the server profile (Dokploy uses a file
# mount, see compose.dokploy.yml).
# NIARO_CONFIG=./config/server.json
#
# Trust X-Forwarded-For from the proxy in front: auto (only with an HTTPS
# public URL), 1 always, 0 never.
# NIARO_TRUST_PROXY=auto
#
# Only these proxy addresses (IPs or CIDR ranges, comma-separated) may set
# X-Forwarded-For. On Dokploy every app shares dokploy-network; set this to
# Traefik's address there (see docs/deployment.md). Unset: any private peer.
# NIARO_TRUSTED_PROXIES=
#
# Agent runs at once across everyone (1–64).
# NIARO_MAX_CONCURRENT_RUNS=8
#
# Data volume name; restore into a new volume and point this at it to switch.
# NIARO_DATA_VOLUME=niaro-data
#
# Image tag the build produces.
# NIARO_IMAGE=niaro:local
