# syntax=docker/dockerfile:1
# Niaro document conversion, Docling engine: layout and table models plus
# Tesseract OCR (Czech, English) on the CPU. Better tables and pages that mix
# text with scans than the MarkItDown image; give it about 2 GB of memory.
# The models are part of the image, so the service needs no network.
FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    CONVERTER_ENGINE=docling \
    DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HOME=/tmp \
    PORT=8000

RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ces libglib2.0-0 libgl1 \
 && rm -rf /var/lib/apt/lists/*
# CPU-only PyTorch: the GPU build is several gigabytes larger and unused.
COPY requirements-docling.txt /app/requirements.txt
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.15.0 torchvision==0.29.2 \
 && pip install -r /app/requirements.txt \
 && HF_HUB_OFFLINE=0 docling-tools models download -o /opt/docling-models layout tableformer

COPY server.py common.py engine_docling.py /app/
RUN useradd --system --uid 10001 --home /app converter
USER converter
WORKDIR /app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s \
  CMD python -c "import urllib.request,os;urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:%s/health'%os.environ['PORT'],headers={'Authorization':'Bearer '+os.environ.get('CONVERTER_TOKEN','')}),timeout=4)" || exit 1
CMD ["python", "server.py"]
