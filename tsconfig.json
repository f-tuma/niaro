{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "jest"],
    "paths": {
      "@admin/*": ["./apps/server-admin/web/*"],
      "@niaro/plugin-sdk": ["./packages/plugin-sdk/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "plugins/**/*.ts",
    "modules/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "spikes/**/*.ts",
    "spikes/**/*.tsx",
    ".rnstorybook/**/*.ts",
    ".rnstorybook/**/*.tsx",
    "app.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-storybook", "spikes/mastra"]
}
